generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  OWNER
  DRIVER
  ADMIN
}

enum DriverSubscriptionStatus {
  NONE
  PENDING
  ACTIVE
  EXPIRED
}

enum City {
  LUXOR
  ASWAN
}

enum PropertyType {
  APARTMENT
  CHALET
  VILLA
  HOTEL
  GUEST_HOUSE
  NILE_CRUISE
}

enum ModerationStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYMOB
  MANUAL
}

enum PayoutStatus {
  PENDING
  PAID
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum VerificationStatus {
  PENDING
  SELFIE_REQUIRED
  SELFIE_PENDING
  APPROVED
  REJECTED
}

enum ExperienceCategory {
  MOUNTAIN_SAFARI
  MOTORCYCLE_TOUR
}

enum ExperienceDifficulty {
  EASY
  MODERATE
  HARD
}

enum TransportType {
  CAR
  COASTER
  BUS
  MOTORCYCLE
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String?
  nationality     String?
  role            Role      @default(GUEST)
  commissionRate  Int       @default(12)
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())

  properties   Property[]
  experiences  Experience[]
  transports   Transport[]
  packages     Package[]
  driverProfile DriverProfile?
  vehicles     Vehicle[]
  bookings     Booking[]
  payouts      Payout[]
  reviews      Review[]
  verification OwnerVerification?
}

model Property {
  id             String           @id @default(cuid())
  ownerId        String
  owner          User             @relation(fields: [ownerId], references: [id])
  name           String
  slug           String           @unique
  type           PropertyType
  city           City
  address        String
  description    String
  lat            Float
  lng            Float
  images         Json             @default("[]")
  videoUrl       String?
  amenities      String[]         @default([])
  maxGuests      Int              @default(2)
  bedrooms       Int              @default(1)
  bathrooms      Int              @default(1)
  areaSqm        Int?
  houseRules     String?
  pickupLat      Float?
  pickupLng      Float?
  basePrice      Int
  commissionRate Int              @default(12)
  cancelPolicy   String           @default("FREE_48H")
  status         ModerationStatus @default(PENDING)
  rating         Float            @default(0)
  reviewCount    Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  availability Availability[]
  priceRules   PriceRule[]
  bookings     Booking[]
  packages     Package[]
  reviews      Review[]

  @@index([city, status])
  @@index([lat, lng])
}

model Availability {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  isBlocked     Boolean  @default(false)
  priceOverride Int?

  @@unique([propertyId, date])
}

model PriceRule {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  price      Int
  minNights  Int      @default(1)

  @@index([propertyId, startDate, endDate])
}

model Experience {
  id              String              @id @default(cuid())
  ownerId         String
  owner           User                @relation(fields: [ownerId], references: [id])
  name            String
  category        ExperienceCategory  @default(MOUNTAIN_SAFARI)
  city            City
  mountain        String
  meetingPoint    String
  durationHours   Int
  capacity        Int
  pricePerPerson  Int
  includes        Json                @default("[]")
  difficulty      ExperienceDifficulty @default(MODERATE)
  bestSeason      String
  cancelPolicy    String
  licenseDocUrl   String
  status          ModerationStatus    @default(PENDING)
  commissionRate  Int                 @default(12)
  createdAt       DateTime            @default(now())

  packages        Package[]

  @@index([city, status])
  @@index([ownerId, status])
}

model Transport {
  id              String        @id @default(cuid())
  ownerId         String
  owner           User          @relation(fields: [ownerId], references: [id])
  name            String
  type            TransportType @default(CAR)
  city            City
  routeFrom       String
  routeTo         String
  meetingPoint    String
  durationHours   Int
  capacity        Int
  pricePerTrip    Int
  includes        Json          @default("[]")
  cancelPolicy    String
  licenseDocUrl   String
  status          ModerationStatus @default(PENDING)
  commissionRate  Int           @default(12)
  createdAt       DateTime      @default(now())

  packages        Package[]

  @@index([city, status])
  @@index([ownerId, status])
}

model DriverProfile {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city               City
  subscriptionStatus DriverSubscriptionStatus @default(PENDING)
  verificationStatus VerificationStatus       @default(PENDING)
  idFront            String
  idBack             String
  licenseDocUrl      String
  note               String?
  submittedAt        DateTime                 @default(now())
  reviewedAt         DateTime?

  @@index([verificationStatus, subscriptionStatus])
}

model Vehicle {
  id             String           @id @default(cuid())
  driverId       String
  driver         User             @relation(fields: [driverId], references: [id])
  name           String
  type           TransportType    @default(CAR)
  city           City
  plateNumber    String
  model          String
  capacity       Int
  pricePerTrip   Int
  routeFrom      String
  routeTo        String
  meetingPoint   String
  durationHours  Int
  includes       Json             @default("[]")
  cancelPolicy   String
  licenseDocUrl  String
  status         ModerationStatus @default(PENDING)
  commissionRate Int              @default(12)
  createdAt      DateTime         @default(now())

  @@index([driverId, status])
  @@index([city, status])
}

model Package {
  id              String           @id @default(cuid())
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id])
  name            String
  city            City
  propertyId      String
  property        Property         @relation(fields: [propertyId], references: [id])
  experienceId    String
  experience      Experience       @relation(fields: [experienceId], references: [id])
  transportId     String
  transport       Transport        @relation(fields: [transportId], references: [id])
  capacity        Int
  pricePerNight   Int
  includes        Json             @default("[]")
  cancelPolicy    String
  licenseDocUrl   String
  status          ModerationStatus @default(PENDING)
  commissionRate  Int              @default(12)
  createdAt       DateTime         @default(now())

  @@index([city, status])
  @@index([ownerId, status])
}

model Booking {
  id              String          @id @default(cuid())
  reference       String          @unique
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id])
  guestId         String
  guest           User            @relation(fields: [guestId], references: [id])
  checkIn         DateTime        @db.Date
  checkOut        DateTime        @db.Date
  nights          Int
  guests          Int
  subtotal        Int
  serviceFee      Int             @default(0)
  commission      Int             @default(0)
  total           Int
  nationality     String?
  paymentMethod   String          @default("CASH")
  paymentNote     String?
  termsAcceptedAt DateTime?
  adminNotifiedAt DateTime?
  status          BookingStatus   @default(PENDING)
  paymentStatus   PaymentStatus   @default(PENDING)
  provider        PaymentProvider @default(MANUAL)
  experience      Json?
  transport       Json?
  packageDetail   Json?
  createdAt       DateTime        @default(now())

  @@index([guestId, createdAt])
  @@index([propertyId, checkIn])
}

model Review {
  id         String       @id @default(cuid())
  propertyId String
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestId    String
  guest      User         @relation(fields: [guestId], references: [id])
  bookingId  String?      @unique
  rating       Int
  comment      String
  ownerReply   String?
  ownerReplyAt DateTime?
  isDemo       Boolean      @default(false)
  status       ReviewStatus @default(PENDING)
  createdAt    DateTime     @default(now())

  @@index([propertyId, status])
}

model OwnerVerification {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneAlt        String?
  birthDate       DateTime?          @db.Date
  nationality     String?
  idFront         String
  idBack          String
  selfie          String?
  status          VerificationStatus @default(PENDING)
  note            String?
  commissionRate  Int                @default(12)
  termsAcceptedAt DateTime?
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
}

model Payout {
  id        String       @id @default(cuid())
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id])
  bookingId String       @unique
  amount    Int
  status    PayoutStatus @default(PENDING)
  createdAt DateTime     @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorEmail String
  actorName  String
  action     String
  target     String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
